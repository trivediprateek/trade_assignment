@startuml Update Trade Sequence

title Update Trade - Kafka Async Flow

actor Client
participant "FastAPI\nEndpoint" as API
queue "Kafka\nBroker" as Kafka
participant "Kafka\nConsumer" as Consumer
participant "TradeService" as Service
participant "PostgreSQL" as DB

Client -> API: PUT /trades/{id}/{version}\n{update_data}
activate API

API -> API: Validate Schema\n(Pydantic TradeUpdate)

alt Maturity Date < Today (if provided)
    API --> Client: 422 Validation Error
else Valid Schema
    API -> API: Build Message\n{operation: "UPDATE",\ndata: {trade_id, version, ...}}
    
    API -> Kafka: produce(topic="trades",\nkey=trade_id,\nvalue=message)
    activate Kafka
    
    Kafka --> API: Message Queued
    deactivate Kafka
    
    API --> Client: 202 Accepted\n{status: "accepted",\nmessage: "update queued"}
    deactivate API
end

== Async Processing ==

Kafka -> Consumer: poll() - fetch message
activate Consumer

Consumer -> Consumer: Parse JSON\nExtract operation="UPDATE"

Consumer -> Consumer: Validate with\nTradeUpdate schema

alt Validation Error
    Consumer -> Consumer: Log Error
    Consumer --> Kafka: Skip Commit
else Valid Data
    Consumer -> Service: update_trade(trade_id,\nversion, update_data)
    activate Service
    
    Service -> DB: get_trade(trade_id, version)
    activate DB
    DB --> Service: existing_trade or None
    deactivate DB
    
    alt Trade Not Found
        Service --> Consumer: HTTPException(404)
        Consumer -> Consumer: Log Error
        Consumer --> Kafka: Skip Commit
    else Trade Found
        Service -> DB: update(existing_trade,\nupdate_data)
        activate DB
        DB --> Service: updated_trade
        deactivate DB
        
        Service --> Consumer: trade_object
        deactivate Service
        
        Consumer -> Consumer: Log Success
        Consumer -> Kafka: commit(offset)
        activate Kafka
        Kafka --> Consumer: Offset Committed
        deactivate Kafka
    end
end

deactivate Consumer

note right of Consumer
  **Update Processing:**
  - Partial updates supported
  - Only provided fields updated
  - Trade must exist
  - Same validation rules apply
end note

@enduml
