@startuml Create Trade Sequence

title Create Trade - Kafka Async Flow

actor Client
participant "FastAPI\nEndpoint" as API
queue "Kafka\nBroker" as Kafka
participant "Kafka\nConsumer" as Consumer
participant "TradeService" as Service
participant "PostgreSQL" as DB

Client -> API: POST /trades\n{trade_data}
activate API

API -> API: Validate Schema\n(Pydantic)

alt Maturity Date < Today
    API --> Client: 422 Validation Error
else Valid Schema
    API -> API: Build Message\n{operation: "CREATE",\ndata: {...}}
    
    API -> Kafka: produce(topic="trades",\nkey=trade_id,\nvalue=message)
    activate Kafka
    
    Kafka --> API: Message Queued
    deactivate Kafka
    
    API --> Client: 202 Accepted\n{status: "accepted",\nmessage: "queued"}
    deactivate API
end

== Async Processing ==

Kafka -> Consumer: poll() - fetch message
activate Consumer

Consumer -> Consumer: Parse JSON\nExtract operation

Consumer -> Consumer: Validate with\nTradeCreate schema

alt Validation Error
    Consumer -> Consumer: Log Error
    Consumer --> Kafka: Skip Commit
else Valid Data
    Consumer -> Service: create_trade(trade_data)
    activate Service
    
    Service -> DB: get_latest_version(trade_id)
    activate DB
    DB --> Service: existing_trade or None
    deactivate DB
    
    alt Existing Trade Found
        alt New Version < Existing Version
            Service --> Consumer: HTTPException(400)
            Consumer -> Consumer: Log Error
            Consumer --> Kafka: Skip Commit
        else New Version == Existing Version
            Service -> DB: delete(existing_trade)
            Service -> DB: create(new_trade)
            DB --> Service: trade_created
            Service --> Consumer: trade_object
        else New Version > Existing Version
            Service -> DB: create(new_trade)
            DB --> Service: trade_created
            Service --> Consumer: trade_object
        end
    else No Existing Trade
        Service -> DB: create(new_trade)
        DB --> Service: trade_created
        Service --> Consumer: trade_object
    end
    
    deactivate Service
    
    Consumer -> Consumer: Log Success
    Consumer -> Kafka: commit(offset)
    activate Kafka
    Kafka --> Consumer: Offset Committed
    deactivate Kafka
end

deactivate Consumer

note right of Kafka
  **Partitioning Strategy:**
  - 3 partitions
  - Key: trade_id
  - Ensures ordering per trade
end note

note right of Consumer
  **Manual Commit:**
  - Only on success
  - At-least-once delivery
  - Reprocesses on failure
end note
    deactivate BG
    
    API --> Client: 201 Created\n{trade_object}
end

deactivate API

@enduml
